{:base-source-path "notebooks"
 :base-target-path "docs"
 :clean-up-target-dir true
 :format [:quarto :html]
 ;; datasets downloadable from the book (docs/notebooks/data/); replaces Clay's default ["src" "notebooks"]
 :subdirs-to-sync ["notebooks/data"]
 ;; ^:replace drops Clay's default formats (its :revealjs makes Quarto book projects warn)
 :quarto {:format ^:replace {:html {:toc true
                                    :toc-location :right
                                    :toc-depth 4
                                    :theme :cosmo
                                    ;; data tables (`nu/data-table`, class `data-table` - `nu/data-table-class`, rename
                                    ;; both together): small type, tight cells, left-aligned, about 8 rows visible
                                    ;; (the header stays); option cards (`nu/option-cards`, class `options`) and mapping lists (`nu/mapping-list`,
                                    ;; class `mapping`): a header line per option, wrapping on narrow screens; shared groups (`nu/shared-groups`, class
                                    ;; `shared`): a grey box of points
                                    :include-in-header
                                    {:text "<style>
.data-table { width: fit-content; max-width: 100%; max-height: 15rem; overflow: auto; margin: 0 0 1rem 0; }
.data-table .table-responsive { overflow: visible; }
.data-table table { font-size: 0.75rem; width: auto; margin: 0; }
.data-table th, .data-table td { padding: 0.1rem 0.45rem !important; white-space: nowrap; }
.data-table thead th { position: sticky; top: 0; background: var(--bs-body-bg, #fff); }
.options { margin: 0.5rem 0 1rem 0; }
.options .option-card { margin: 0 0 0.9rem 0; border: 1px solid var(--bs-border-color, #dee2e6); border-radius: 0.375rem; overflow: hidden; }
.options dt { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.1rem 1rem; margin: 0; padding: 0.4rem 0.75rem; background: #eef2f7; border-bottom: 1px solid var(--bs-border-color, #dee2e6); font-weight: normal; }
.options dt > code { font-weight: 700; font-size: 1rem; background: none; padding: 0; }
.options .option-default { font-size: 0.85rem; color: var(--bs-secondary-color, #6c757d); }
.options dd { margin: 0; padding: 0.5rem 0.75rem; }
.options .option-example { font-size: 0.85rem; padding: 0 0 0.45rem 0; margin-bottom: 0.45rem; border-bottom: 1px dashed var(--bs-border-color, #dee2e6); }
.options .option-example code { background: none; padding: 0; }
.options .option-text ul { margin: 0.3rem 0 0 0; padding-left: 1.25rem; }
.options code, .mapping code { overflow-wrap: anywhere; }
.mapping { margin: 0.5rem 0 1rem 0; padding: 0.5rem 0.75rem; border: 1px solid var(--bs-border-color, #dee2e6); border-left: 0.3rem solid #2780e3; border-radius: 0.375rem; background: #f5f8fc; }
.mapping-title { font-weight: 700; margin-bottom: 0.25rem; }
.mapping-hint { font-weight: normal; font-size: 0.85rem; color: var(--bs-secondary-color, #6c757d); }
.mapping ul { margin: 0; padding-left: 1.25rem; }
.mapping .required { font-size: 0.75rem; padding: 0 0.3rem; border: 1px solid currentColor; border-radius: 0.25rem; }
.shared { margin: 0.5rem 0 1rem 0; padding: 0.5rem 0.75rem; border: 1px solid var(--bs-border-color, #dee2e6); border-left: 0.3rem solid #6c757d; border-radius: 0.375rem; background: #f6f6f6; }
.shared-title { font-weight: 700; margin-bottom: 0.25rem; }
.shared-hint { font-weight: normal; font-size: 0.85rem; color: var(--bs-secondary-color, #6c757d); }
.shared ul { margin: 0; padding-left: 1.25rem; }
.shared code { overflow-wrap: anywhere; }
</style>"}}}
          :code-block-background true}}
