;; Book chapters in reading order (paths relative to notebooks/); the first one becomes the index page.
;; The reference has four parts - Concepts, Charts (ten chapters grouped by what they show), Builders, Data functions
;; (with specific cases); Quarto books allow one level of parts, so they're consecutive parts; use case sections follow the R
;; Graph Gallery site order (distribution, correlation, ranking, part of a whole, evolution, flow, then colours from
;; its general knowledge part); galleries: lattice, vega, cljplot.
;; Parts without chapters are left out of the book.
["book/index.clj"
 {:part "Concepts" :chapters ["reference/intro.clj" "reference/render.clj" "reference/data_mapping.clj"
                              "reference/types.clj" "reference/aesthetics_legends.clj"
                              "reference/scales_axes_coords.clj" "reference/layering_position.clj"
                              "reference/labels_text.clj" "reference/facets_arrange.clj" "reference/theme.clj"
                              "reference/shared_options.clj" "reference/errors.clj" "reference/limits.clj"]}
 {:part "Charts" :chapters ["reference/charts_points_lines.clj" "reference/charts_annotations.clj"
                            "reference/charts_bars.clj" "reference/charts_per_level.clj"
                            "reference/charts_one_variable.clj" "reference/charts_fitted_curves.clj"
                            "reference/charts_bins_fields.clj" "reference/charts_pairwise.clj"
                            "reference/charts_shares_sets.clj" "reference/charts_multivariate_3d.clj"]}
 {:part "Builders" :chapters ["reference/builders_graphs.clj" "reference/builders_trees.clj"
                              "reference/builders_series.clj"]}
 {:part "Data functions" :chapters ["reference/data_levels.clj" "reference/data_graphs_trees.clj"
                                    "reference/data_sets_series.clj" "reference/data_fields.clj"
                                    "reference/specific_cases.clj"]}
 {:part "Use cases" :chapters ["use_cases/distribution.clj" "use_cases/correlation.clj" "use_cases/ranking.clj"
                               "use_cases/part_of_a_whole.clj" "use_cases/evolution.clj" "use_cases/flow.clj"
                               "use_cases/colors.clj"]}
 {:part "Galleries" :chapters ["galleries/lattice.clj" "galleries/vega.clj" "galleries/cljplot.clj"]}]
