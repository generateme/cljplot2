 :gapminder-2007 {:file "gapminder-2007.csv"
                  :format :csv
                  :title "Gapminder 2007: life expectancy, population and GDP per capita"
                  :source "data-to-viz example dataset `4_ThreeNum` (Yan Holtz; Gapminder via the R gapminder package)"
                  :licence "MIT (data_to_viz repository)"
                  :via "GitHub raw holtzy/data_to_viz Example_dataset/4_ThreeNum.csv, header renamed to kebab-case"
                  :notes "142 rows: `country`, `continent` (5), `life-exp` (years), `pop`, `gdp-per-cap` (USD, inflation-adjusted)."}
 :countries {:file "countries.csv"
             :format :csv
             :title "Countries: demographic indicators"
             :source "data-to-viz example dataset `multivariate` (Yan Holtz; original source not documented)"
             :licence "MIT (data_to_viz repository)"
             :via "GitHub raw holtzy/data_to_viz Example_dataset/multivariate.csv, `;` -> `,`, header renamed to kebab-case, CRLF -> LF"
             :notes "201 rows: `country`, `pop` (thousands), `birth-rate`, `mortality-rate`, `life-expectancy`, `infant-mortality`, `children-per-woman`, `growth-rate`, `population-aged-65` (thousands), `group` (subregion), `continent` (6, `South America` holds the Americas)."}
 :miserables-characters {:file "miserables-characters.csv"
                         :format :csv
                         :title "Les Misérables characters"
                         :source "vega-datasets `miserables.json` (D. E. Knuth, The Stanford GraphBase, 1993)"
                         :licence "Not specified (vega-datasets lists it as notspecified)"
