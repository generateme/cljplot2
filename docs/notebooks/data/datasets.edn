;; Datasets used by the notebooks: key -> {:file :format :title :source :licence :via :strings? :notes?}
;; `:file` is relative to this folder, `:format` is :json (array of objects) or :csv (header row).
;; `:source` and `:licence` describe the original data and are shown in each example's attribution line;
