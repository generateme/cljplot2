 :migration {:file "migration.csv"
             :format :csv
             :title "Migration flows between world regions"
             :source "data-to-viz example dataset `13_AdjacencyDirectedWeighted` (long form; Yan Holtz, after Abel & Sander 2014)"
             :licence "MIT (data_to_viz repository)"
             :via "cljplot2 dev/resources (data_to_viz 13_AdjacencyDirectedWeighted_long.csv)"
             :notes "100 rows: `from`, `to` (10 regions; some spelled with dots, e.g. `South.Asia`), `value` (millions of migrants; zeros and the diagonal included)."}
 :coauthors {:file "coauthors.csv"
             :format :csv
             :title "Co-authorships between researchers"
