;; Datasets used by the notebooks: key -> {:file :format :title :source :licence :via :strings? :notes?}
;; `:file` is relative to this folder, `:format` is :json (array of objects) or :csv (header row).
;; `:source` and `:licence` describe the original data and are shown in each example's attribution line;
;; `:via` says where this copy comes from (not shown).
;; `:strings` (CSV only, optional) - column keywords kept as strings (e.g. ids with leading zeros).
{:faithful {:file "faithful.json"
            :format :json
            :title "Old Faithful geyser eruptions"
            :source "R datasets package `faithful` (Härdle 1991; Azzalini & Bowman 1990)"
            :licence "Part of R (GPL-2 | GPL-3)"
            :via "cljplot2 dev/resources"
            :notes "272 rows: `eruptions` (eruption time, min), `waiting` (time to next eruption, min)."}
 :iris {:file "iris.csv"
        :format :csv
        :title "Edgar Anderson's iris measurements"
        :source "R datasets package `iris` (Anderson 1935; Fisher 1936)"
        :licence "Part of R (GPL-2 | GPL-3)"
        :via "Rscript: datasets::iris, columns renamed to kebab-case, write.csv"
        :notes "150 rows: `sepal-length`, `sepal-width`, `petal-length`, `petal-width` (cm), `species`."}
 :mtcars {:file "mtcars.csv"
          :format :csv
          :title "Motor Trend car road tests (1974)"
          :source "R datasets package `mtcars` (Henderson & Velleman 1981)"
          :licence "Part of R (GPL-2 | GPL-3)"
          :via "Rscript: datasets::mtcars, row names as column `model`, write.csv"
          :notes "32 rows: `model`, `mpg`, `cyl`, `disp`, `hp`, `drat`, `wt`, `qsec`, `vs`, `am`, `gear`, `carb`."}
 :diamonds {:file "diamonds.csv"
            :format :csv
            :title "Prices and attributes of round cut diamonds"
            :source "R ggplot2 package `diamonds` (Wickham et al.)"
            :licence "MIT (ggplot2)"
            :via "Rscript: ggplot2::diamonds, write.csv"
            :notes "53940 rows: `carat`, `cut`, `color`, `clarity`, `depth`, `table`, `price` (USD), `x`, `y`, `z` (mm)."}
 :lincoln-weather {:file "lincoln-weather.csv"
                   :format :csv
                   :title "Weather in Lincoln, Nebraska, 2016"
                   :source "R ggridges package `lincoln_weather` (Weather Underground, via Wilke)"
                   :licence "GPL-2 (ggridges)"
                   :via "Rscript: ggridges::lincoln_weather, columns CST, Month and the mean / max / min temperatures, write.csv"
                   :strings [:date]
                   :notes "366 rows: `date`, `month` (name), `mean-temp`, `max-temp`, `min-temp` (degrees F)."}
 :chem97 {:file "chem97.csv"
          :format :csv
          :title "A-level chemistry scores, England 1997"
          :source "R mlmRev package `Chem97` (Yang et al. 2002)"
          :licence "GPL (>= 2) (mlmRev)"
          :via "Rscript: mlmRev::Chem97, write.csv"
          :strings [:lea :school :student]
          :notes "31022 rows: `lea`, `school`, `student` (ids), `score` (A-level points 0-10), `gender`, `age` (months, centred), `gcsescore`, `gcsecnt` (centred)."}
 :barley {:file "barley.json"
          :format :json
          :title "Barley yields, Minnesota 1931-1932"
          :source "R lattice package `barley` (Immer et al. 1934; Fisher 1971; Cleveland 1993)"
          :licence "GPL (>= 2) (lattice)"
          :via "cljplot2 dev/resources"
          :notes "120 rows: `yield` (bushels/acre), `variety`, `year`, `site`."}
 :quakes {:file "quakes.json"
          :format :json
          :title "Earthquakes off Fiji since 1964"
          :source "R datasets package `quakes` (Harvard PRIM-H project)"
          :licence "Part of R (GPL-2 | GPL-3)"
          :via "cljplot2 dev/resources"
          :notes "1000 rows: `lat`, `long`, `depth` (km), `mag` (Richter), `stations`."}
 :economics {:file "economics.csv"
             :format :csv
             :title "US economic time series, 1967-2015"
             :source "R ggplot2 package `economics` (Federal Reserve Bank of St. Louis, FRED)"
             :licence "MIT (ggplot2)"
             :via "Rscript: ggplot2::economics (ggplot2 4.0.3), date as ISO yyyy-mm-dd, write.csv"
             :notes "574 monthly rows: `date` (ISO string), `pce` (personal consumption expenditures, billions USD), `pop` (thousands), `psavert` (personal savings rate, %), `uempmed` (median unemployment duration, weeks), `unemploy` (unemployed, thousands)."}
 :chick-weight {:file "chick-weight.csv"
                :format :csv
                :title "Weight versus age of chicks on four diets"
                :source "R datasets package `ChickWeight` (Crowder & Hand 1990)"
                :licence "Part of R (GPL-2 | GPL-3)"
                :via "Rscript: datasets::ChickWeight, columns renamed to lower case, chick and diet as strings, write.csv"
                :strings [:chick :diet]
                :notes "578 rows: `weight` (g), `time` (days since birth, 0-21), `chick` (id, 50 chicks), `diet` (\"1\"-\"4\")."}
 :air-passengers {:file "air-passengers.csv"
                  :format :csv
                  :title "Monthly airline passengers, 1949-1960"
                  :source "R datasets package `AirPassengers` (Box & Jenkins 1976)"
                  :licence "Part of R (GPL-2 | GPL-3)"
                  :via "Rscript: datasets::AirPassengers as rows: first day of the month (ISO), year, month abbreviation, write.csv"
                  :notes "144 rows: `date` (ISO string), `year`, `month` (Jan-Dec), `passengers` (thousands)."}}
