{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        clojure2d/clojure2d {:mvn/version "1.5.0-alpha3-SNAPSHOT"}
        generateme/fastmath {:mvn/version "3.0.0-alpha10-SNAPSHOT"}
        org.scicloj/wadogo {:mvn/version "1.1.0-alpha2-SNAPSHOT"}
        metosin/malli {:mvn/version "0.20.3"}
        org.clojure/core.cache {:mvn/version "1.2.999"}}
 :aliases {;; REPL / editor: dev and test sources, demo data and every dev-only dependency
           :dev {:extra-paths ["dev" "dev/resources" "test"]
                 :extra-deps {org.clojure/data.json {:mvn/version "2.5.1"}
                              org.clojure/data.csv {:mvn/version "1.1.0"}
                              org.clojure/test.check {:mvn/version "1.1.1"}}}
           :test {:extra-paths ["test" "dev" "dev/resources" "notebooks"]
                  :extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}
                               ;; notebook helpers (`notebook-utils`) and their data readers
                               org.scicloj/kindly {:mvn/version "4-beta25"}
                               org.clojure/data.json {:mvn/version "2.5.1"}
                               org.clojure/data.csv {:mvn/version "1.1.0"}
                               io.github.cognitect-labs/test-runner {:git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
                  :main-opts ["-m" "cognitect.test-runner"]
                  :exec-fn cognitect.test-runner.api/test}
           :check {:extra-paths ["dev"]
                   :main-opts ["-m" "cljplot2.check"]}
           ;; every step demo in one JVM: `clojure -M:demo [stepN | stepN/<file-name>]...`, see `cljplot2.demo`
           :demo {:extra-paths ["dev" "dev/resources"]
                  :extra-deps {org.clojure/data.json {:mvn/version "2.5.1"}
                               org.clojure/data.csv {:mvn/version "1.1.0"}}
                  :main-opts ["-m" "cljplot2.demo"]}
           ;; notebooks on the classpath (REPL work on notebooks, with any REPL alias): Clay and data readers
           :notebooks {:extra-paths ["notebooks"]
                       :extra-deps {org.scicloj/clay {:mvn/version "2.0.24"}
                                    org.clojure/data.json {:mvn/version "2.5.1"}
                                    org.clojure/data.csv {:mvn/version "1.1.0"}}}
           ;; book build (Clay + Quarto) into `docs/`: `clojure -M:clay [serve [port]]`, see `book.build`; standalone
           ;; (own paths and deps), so `:notebooks` stays free of main-opts for REPL jack-in
           :clay {:extra-paths ["notebooks"]
                  :extra-deps {org.scicloj/clay {:mvn/version "2.0.24"}
                               org.clojure/data.json {:mvn/version "2.5.1"}
                               org.clojure/data.csv {:mvn/version "1.1.0"}}
                  :main-opts ["-m" "book.build"]}}}
